# ==========================================================================
# SciAtlas workflow configuration (.env)
# Copy to .env and fill in the keys you need. All names below are read by
# run_sciatlas.py / review_pipeline / literature_review_pipeline / sciatlas_idea_gen.
# ==========================================================================

# ----- Required: LLM for rubric / review / report synthesis ---------------
# Any OpenAI-compatible Chat Completions endpoint works.
# LLM_API_KEY aliases: DMX-API-KEY / DMX_API_KEY / OPENAI_API_KEY
# LLM_BASE_URL aliases: OPENAI_BASE_URL   |   LLM_MODEL aliases: OPENAI_MODEL
LLM_API_KEY=
LLM_BASE_URL=https://www.dmxapi.cn/v1
LLM_MODEL=DeepSeek-V3.2
LLM_PROVIDER=chat_completions
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=4
LLM_MAX_TOKENS=512
LLM_API_URL=
LLM_CHAT_COMPLETIONS_URL=
LLM_AUTH_HEADER=
LLM_HTTP_HEADERS=

# ----- Hosted SciAtlas knowledge-graph search -------------------------------
# Backend for the idea-evaluate search stage when no local Neo4j is present
# (review_pipeline/kg_search/service_hosted.py). Get a token at
# http://sciatlas.openkg.cn/register
SCIATLAS_API_KEY=
SCIATLAS_API_BASE_URL=http://sciatlas.openkg.cn
SCIATLAS_TIMEOUT=300

# ----- Optional external services -------------------------------------------
# Semantic Scholar (search + reviewer branches; dash form S2-API-KEY also accepted,
# plus S2-API-KEY1 / S2-API-KEY2 rotation)
S2_API_KEY=
# OpenAlex (manifest stage PDF resolution; without a key the public pool is used —
# set OPENALEX_MAILTO for polite-pool priority)
OA_API_KEY=
OPENALEX_MAILTO=
# GROBID service for PDF parsing in the manifest stage (full idea-evaluate only):
#   docker run --rm -p 8070:8080 grobid/grobid
GROBID_BASE_URL=http://127.0.0.1:8070

# ----- SciAtlas client / run directories ------------------------------------
SCIATLAS_RUNS_DIR=./runs
SCIATLAS_WORKFLOW_ENV=.env
SCIATLAS_OFFICIAL_CLI_ROOT=.
SCIATLAS_CACHE_DIR=./runs/cache
SCIATLAS_USE_LOCAL_KG=0
SCIATLAS_LOCAL_SEARCH_ROOT=./references/search
SCIATLAS_MAX_RETRIES=4
SCIATLAS_RETRY_BACKOFF=5.0

# ----- Server-only: local Neo4j KG -------------------------------------------
# Optional local knowledge-graph backend. When Neo4j (or the local model
# dependencies) is unavailable, the pipelines fall back to the hosted backend
# and LLM-generated reviewer backgrounds automatically.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
